# 本地构建版：本机已 `npm run build` 出 .output，服务器不跑 nuxt build（避免 2G 内存 OOM）。
# 服务器只做一件事：为 better-sqlite3 装 Linux 原生二进制（prebuild-install 下载预编译包，秒级，
# 无需编译工具链）。.output 里的 Windows 版 better_sqlite3.node 会被覆盖掉。
FROM docker.1ms.run/library/node:22-slim AS runner

WORKDIR /app

# 只安装运行期唯一的原生依赖 better-sqlite3。
# 优先走 prebuild-install 下载 Linux 预编译二进制（秒级）；若网络拉不到（国内服务器
# 连 GitHub releases 常超时），回退到 node-gyp 从源码编译——better-sqlite3 的 sqlite3.c
# 随 npm 包自带，编译不依赖外网。故装上 python3/make/g++ 工具链兜底，编译后卸掉控制体积。
COPY package.runner.json ./package.json
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && npm install --omit=dev --registry=https://registry.npmmirror.com \
 && npm cache clean --force \
 && apt-get purge -y python3 make g++ \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# 本地构建好的产物与数据
COPY .output ./.output
COPY data ./data

# 用 Linux 版 better-sqlite3 覆盖 .output 内打包的 Windows 版二进制
RUN set -e; \
    SRC=$(find node_modules/better-sqlite3 -name 'better_sqlite3.node' | head -1); \
    DST=$(find .output -name 'better_sqlite3.node' | head -1); \
    if [ -n "$SRC" ] && [ -n "$DST" ]; then cp -f "$SRC" "$DST"; echo "patched $DST"; \
    else echo "WARN: better_sqlite3.node not found (src=$SRC dst=$DST)"; fi

ENV HOST=0.0.0.0
ENV PORT=3000
ENV NODE_ENV=production

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
