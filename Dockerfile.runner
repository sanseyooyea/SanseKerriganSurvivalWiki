# 本地构建版：本机已 `npm run build` 出 .output，服务器不跑 nuxt build（避免 2G 内存 OOM）。
# 服务器只做一件事：为 better-sqlite3 装 Linux 原生二进制（prebuild-install 下载预编译包，秒级，
# 无需编译工具链）。.output 里的 Windows 版 better_sqlite3.node 会被覆盖掉。
FROM docker.1ms.run/library/node:22-slim AS runner

WORKDIR /app

# 只安装运行期唯一的原生依赖 better-sqlite3。
# 优先走 prebuild-install 下载 Linux 预编译二进制（秒级）；若网络拉不到（国内服务器
# 连 GitHub releases 常超时），回退到 node-gyp 从源码编译——better-sqlite3 的 sqlite3.c
# 随 npm 包自带，编译不依赖外网。故装上 python3/make/g++ 工具链兜底，编译后卸掉控制体积。
COPY package.runner.json ./package.json
# 换阿里云 apt 源：国内服务器连 deb.debian.org 拉 8MB+ 的 Packages 索引常降到 ~40KB/s
# 导致 apt-get update 卡死（deploy 曾两次停在 Get:4 Packages）。bookworm 用 deb822 格式的
# debian.sources；同时兜底改经典 sources.list。阿里云实测拉全量 Packages.gz 约 6s。
RUN set -e; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list; \
    fi
# python3 留在镜像里：录像解析器（scripts/replay/parse_replay.py）运行时要用。
# 只卸编译工具链。python3 先标记为手动安装，否则 autoremove 会把它当作 g++ 的依赖一并清掉。
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && apt-mark manual python3 python3-minimal \
 && npm install --omit=dev --registry=https://registry.npmmirror.com \
 && npm cache clean --force \
 && apt-get purge -y make g++ \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# 录像解析器 + 随包依赖（sc2reader wheel、mpyq.py，见 scripts/replay/vendor/README.md）。
# 构建期把 wheel 解压到 vendor/site 并预编译 .pyc：从 zip 导入时每次都要重新编译源码，
# 在 2 核机器上每局白耗 ~0.5s CPU。最后跑一次 --help 冒烟，导入失败直接让 build 失败。
COPY scripts/replay ./scripts/replay
RUN cd scripts/replay/vendor \
 && python3 -c "import zipfile; zipfile.ZipFile('sc2reader-1.8.0-py3-none-any.whl').extractall('site')" \
 && python3 -m compileall -q site mpyq.py ../parse_replay.py \
 && python3 -I ../parse_replay.py --help > /dev/null

# 本地构建好的产物与数据（data/replays 是用户上传，走 bind mount，不进镜像，见 .dockerignore）
COPY .output ./.output
COPY data ./data

# 用 Linux 版 better-sqlite3 覆盖 .output 内打包的 Windows 版二进制
RUN set -e; \
    SRC=$(find node_modules/better-sqlite3 -name 'better_sqlite3.node' | head -1); \
    DST=$(find .output -name 'better_sqlite3.node' | head -1); \
    if [ -n "$SRC" ] && [ -n "$DST" ]; then cp -f "$SRC" "$DST"; echo "patched $DST"; \
    else echo "WARN: better_sqlite3.node not found (src=$SRC dst=$DST)"; fi

ENV HOST=0.0.0.0
ENV PORT=3000
ENV NODE_ENV=production

EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
