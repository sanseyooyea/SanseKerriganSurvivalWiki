# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，不会提交）

# JWT 签名密钥（必填，生产环境缺失会拒绝启动）
# 生成示例：openssl rand -base64 48
JWT_SECRET=your-jwt-secret-here

# === 邮件（SMTP）— 用于密码重置 ===
# 全部可选；若 SMTP_HOST 留空则重置链接只打印到 console（方便开发调试）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=KS2 Wiki <noreply@example.com>

# 站点公开地址（重置链接前缀，末尾不带 /）
APP_URL=https://wiki.ks2.top
